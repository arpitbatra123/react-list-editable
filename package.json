		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.2.1",
		"prop-types": "^15.8.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sass": "^1.70.0",
		"vite": "^5.0.12"
